# Copy this file to .env for a safe local-only development stack. Do not commit .env.
# These values are intentionally non-production placeholders, not credentials.
POSTGRES_DB=unshaken_development
POSTGRES_USER=unshaken_developer
POSTGRES_PASSWORD=development-only-not-a-secret
DATABASE_URL=postgresql+asyncpg://unshaken_developer:development-only-not-a-secret@database:5432/unshaken_development
FRONTEND_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# Add the real key only to your ignored local .env or a deployment secret store.
# Never add a real API key to this file or commit a populated .env file.
EXERCISE_DB_BASE_URL=https://exercisedb.p.rapidapi.com
EXERCISE_DB_API_KEY=
EXERCISE_DB_HOST=exercisedb.p.rapidapi.com
EXERCISE_DB_MEDIA_ENABLED=false
# Generate a UUID for local development. This temporary identity is rejected outside development.
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_EMAIL=local@unshaken.invalid
DEVELOPMENT_USER_DISPLAY_NAME=Local User
